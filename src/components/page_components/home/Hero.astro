---
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import {Scroll} from "lucide-react";
---
<main class="max-h-50 max-md:items-center">
    <a href="/about">
        <div class="h-50 w-50 min-w-50 min-h-50 max-w-50 max-h-50 max-md:h-32 max-md:w-32 max-md:min-w-32 max-md:min-h-32 max-md:max-w-32 max-md:max-h-32 rounded-full z-10 bg-gray-100 overflow-hidden shrink-0">
            <img src="/pfp.jpg" alt="Charles Degraeuwe" loading="lazy" class="object-cover scale-125">
        </div>
    </a>
    <div class="flex flex-col justify-center gap-1 max-md:text-center">
        <a href="/about"><h1>Charles Degraeuwe</h1></a>
        <div class="flex flex-row max-sm:flex-col gap-10 max-sm:gap-2 opacity-50">
            <a href="/work" class="home_a flex items-center gap-2">
                <GraduationCap size={15}/>
                Student full-stack engineer
            </a>
            <a
                    href={"/resume/Charles Degraeuwe - Full Stack Developer.pdf"}
                    download={"Charles Degraeuwe - Full Stack Developer"}
                    class={"home_a flex items-center gap-2 cursor-pointer"}>
                <Scroll size={15}/>
                Download resume
            </a>
        </div>
    </div>
</main>
