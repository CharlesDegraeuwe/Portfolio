---
import {getCollection, render} from 'astro:content';
import RootLayout from "../../layouts/RootLayout.astro";
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import TableOfContents from '../../components/page_components/work/TableOfContents';
import AnimateOnMount from "../../components/page_components/layout/header/AnimateOnMount.tsx";
import SitePreview from "../../components/page_components/work/SitePreview.astro";

export async function getStaticPaths() {
    const projects = await getCollection('work');
    return projects.map((project) => ({
        params: {id: project.id},
        props: {project},
    }));
}

const {project} = Astro.props;
const {Content, headings} = await render(project);   // markdown-body -> component

const siteUrl = (Astro.site ?? Astro.url).origin;
const projectSchema = {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: project.data.title,
    description: project.data.description,
    url: canonicalFor(),
    author: { "@id": `${siteUrl}/#person` },
    keywords: (project.data.tags ?? []).join(", "),
    ...(project.data.preview ? { sameAs: project.data.preview } : {}),
};
function canonicalFor() {
    return new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
}
---

<RootLayout title={project.data.title} description={project.data.description} schema={projectSchema}>
    <main class="main-page article-scroll w-full max-w-none h-full overflow-y-auto flex scroll-hidden">
        <div class="w-full max-w-240 flex gap-12 items-start justify-start scroll-hidden">
            <div class="min-w-0 flex-1 flex flex-col gap-8 scroll-hidden">
                <AnimateOnMount client:load delay={0}>
                    <a href="/work"
                       class="home_a flex items-center gap-2 text-sm opacity-60 hover:opacity-100 w-fit">
                        <ArrowLeft size={14}/>
                        Back to work
                    </a>
                </AnimateOnMount>

                <AnimateOnMount client:load delay={100}>
                    <section class="flex flex-col gap-1">
                        <h3 class="text-2xl">{project.data.date}</h3>
                        <h1>{project.data.title}</h1>
                        <div class="flex flex-row gap-1 mb-5">{(project.data.tags ?? []).map((tag, index) => {
                            return(<div class="px-2 bg-amber-50 py-0.5 rounded-4xl border text-sm border-zinc-200">
                                {tag}
                            </div>)
                        })}</div>
                        <hr class="max-w-1/8 border-zinc-300"/>
                    </section>
                </AnimateOnMount>

                {project.data.preview && (
                    <AnimateOnMount client:load delay={150}>
                        <SitePreview link={project.data.preview} title={project.data.title}/>
                    </AnimateOnMount>
                )}

                <AnimateOnMount client:load delay={200}>
                    <article class="prose prose-zinc max-w-none">
                        <Content/>
                    </article>
                </AnimateOnMount>
                <TableOfContents client:load headings={headings}/>
            </div>

        </div>
    </main>
</RootLayout>
