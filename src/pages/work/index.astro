---
import {getCollection} from 'astro:content';
import RootLayout from "../../layouts/RootLayout.astro";
import WorkSection from '../../components/page_components/work/WorkSection';
import Title from "../../components/page_components/layout/title/title.astro";
import AnimateOnMount from "../../components/page_components/layout/header/AnimateOnMount.tsx";

const projects = (await getCollection('work')).map((entry) => entry.data);
---
<RootLayout title="Work" description="A selection of products and tools I've designed and built.">
    <main class="main-page gap-5 flex flex-col">
        <AnimateOnMount client:load delay={0}>
            <Title title="Work" subtitle="Recent projects" description="A selection of products and tools I’ve designed and built." noBorder/>
        </AnimateOnMount>
        <WorkSection projects={projects ?? []} client:load/>
    </main>
</RootLayout>