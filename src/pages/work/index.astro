---
import {getCollection} from 'astro:content';
import RootLayout from "../../layouts/RootLayout.astro";
import WorkSection from '../../components/work/WorkSection';
import Title from "../../components/layout/title/title.astro";

const projects = (await getCollection('work')).map((entry) => entry.data);
---
<RootLayout title="Work" description="A selection of products and tools I've designed and built.">
    <main class="main-page gap-5 flex flex-col">
        <Title title="Work" subtitle="Recent projects" description="A selection of products and tools I’ve designed and built." noBorder/>
        <WorkSection projects={projects}/>
    </main>
</RootLayout>