---
import {getCollection} from 'astro:content';
import MySiteLayout from '../../layouts/MySiteLayout.astro';
import WorkSection from '../../components/work/WorkSection';

const projects = (await getCollection('work')).map((entry) => entry.data);
---
<MySiteLayout title="Home Page">
    <main class="main-page gap-5 flex flex-col">
        <section>
            <h3>Recent projects</h3>
            <h1>Work</h1>
            <h2>I'm currently building Studo. Here are a few other things I've designed and built.</h2>
        </section>
        <WorkSection projects={projects}/>
    </main>
</MySiteLayout>